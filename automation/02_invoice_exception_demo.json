      "id": "synthetic-inputs",
      "name": "Synthetic inputs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        380,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{json:{invoice_id:'INV-301',lead_id:'LEAD-201',amount_inr:12000,paid_inr:0,due_date:'2026-10-10',owner:'finance'}},{json:{invoice_id:'INV-302',lead_id:'LEAD-205',amount_inr:8000,paid_inr:3000,due_date:'2026-10-12',owner:'finance'}},{json:{invoice_id:'INV-303',lead_id:'LEAD-206',amount_inr:3999,paid_inr:3999,due_date:'2026-10-12',owner:'finance'}}];"
      }
    },
    {
      "id": "apply-exception-rules",
      "name": "Apply exception rules",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        670,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const asOf='2026-10-16';return $input.all().map(x=>{const i=x.json;const balance=Math.max(0,Number(i.amount_inr)-Number(i.paid_inr));return {json:{...i,unpaid_balance_inr:balance,is_overdue:i.due_date<asOf&&balance>0}}}).filter(x=>x.json.is_overdue);"
      }
    },
    {
      "id": "prepare-queue-records",
      "name": "Prepare queue records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(x=>({json:{queue:'invoice_exception',invoice_id:x.json.invoice_id,lead_id:x.json.lead_id,owner:x.json.owner,unpaid_balance_inr:x.json.unpaid_balance_inr,idempotency_key:['invoice_overdue',x.json.invoice_id,'2026-10-16'].join(':'),recommended_action:'Reconcile Razorpay status and assign finance follow-up; avoid duplicate reminders',write_performed:false}}));"
      }
    }
  ],
