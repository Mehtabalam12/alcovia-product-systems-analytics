      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const asOf=new Date('2026-10-16T00:00:00Z');const limits={qualified:2,discovery_scheduled:2,ambition_attended:3,architect_attended:3};return $input.all().map(x=>{const l=x.json;const days=Math.max(0,Math.floor((asOf-new Date(l.entered_at+'T00:00:00Z'))/86400000));return {json:{...l,days_in_stage:days,sla_days:limits[l.stage]??null,overdue:limits[l.stage]!==undefined&&days>limits[l.stage]}}}).filter(x=>x.json.overdue);"
      }
    },
    {
      "id": "prepare-queue-records",
      "name": "Prepare queue records",
      "type": "n8n-nodes-base.code",
