      "position": [
        980,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(x=>({json:{queue:'lead_follow_up',lead_id:x.json.lead_id,owner:x.json.owner,exception:'Stage SLA exceeded',days_in_stage:x.json.days_in_stage,sla_days:x.json.sla_days,idempotency_key:['lead_sla',x.json.lead_id,x.json.stage,'2026-10-16'].join(':'),recommended_action:'Request sales-owner review; do not automatically contact a minor',write_performed:false}}));"
      }
