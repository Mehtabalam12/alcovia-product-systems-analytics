        "jsCode": "return $input.all().map(x=>({json:{queue:'student_advisor_review',student_id:x.json.student_id,advisor:x.json.advisor,reason:'Focus declined 60%+ AND two or more missed deadlines',focus_decline_pct:Math.round(x.json.focus_decline_ratio*100),idempotency_key:['student_engagement',x.json.student_id,'2026-W42'].join(':'),recommended_action:'Private advisor review; listen to student context before any parent escalation',write_performed:false}}));"
      }
