      "typeVersion": 2,
      "position": [
        670,
        260
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all().map(x=>{const s=x.json;const fall=s.focus_prev_7d>0?(s.focus_prev_7d-s.focus_last_7d)/s.focus_prev_7d:null;const low=fall!==null&&fall>=0.6&&s.missed_deadlines>=2;return {json:{...s,focus_decline_ratio:fall,requires_checkin:low}}}).filter(x=>x.json.requires_checkin);"
      }
    },
    {
      "id": "prepare-queue-records",
      "name": "Prepare queue records",
      "type": "n8n-nodes-base.code",
